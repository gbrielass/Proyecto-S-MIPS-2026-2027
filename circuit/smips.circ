    <comp lib="7" loc="(480,50)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Lectura combinacional; escritura en el flanco de subida de CLK con WE=1, solo en los bytes con BE=1."/>
    </comp>
    <comp lib="7" loc="(480,70)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Se usan los bits 13..2 de ADDR; los demas se ignoran (el espacio se repite cada 16 KiB)."/>
    </comp>
